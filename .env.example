# Database (local PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/yatradb

# Direct connection to the database. Used for migrations
DIRECT_URL=postgresql://postgres:password@localhost:5432/yatradb

# Better Auth
BETTER_AUTH_SECRET=your_strong_random_secret_min_32_chars
BETTER_AUTH_URL=http://localhost:3000

# Resend (password reset emails) - https://resend.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM="Yatra <noreply@yourdomain.com>"

# Encryption secret for field-level encryption
# Generate a strong random string: openssl rand -base64 32
ENCRYPTION_SECRET=your_strong_random_secret_min_32_chars

# Local file storage for wallet icons (optional, default ./data/uploads)
UPLOAD_DIR=./data/uploads
